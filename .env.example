# =============================================================================
# MODELE DE CONFIGURATION PRODUCTION (.env.example -> copier en config/.env)
# Verrouiller les permissions NTFS (Lecture seule pour le compte de service)
# =============================================================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8089

# Parametres Microsoft SQL Server
SQL_SERVER=<NOM_OU_IP_SERVEUR_SQL>,1433
SQL_DATABASE=<NOM_BASE_SQL>
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no

# Journalisation applicative
LOG_FILE_PATH=C:\Apps\<NOM_APPLICATION>\logs\app_server.log
